import paho.mqtt.client as mqtt
import threading
import time

BROKER = "broker.hivemq.com"
PORT = 1883
TOPIC_DIGITS = "lab2/KamaevMarselIST32/task1/digits"
TOPIC_CHARS  = "lab2/KamaevMarselIST32/task1/chars"

def on_message(client, userdata, msg):
    print(f"[{msg.topic}] {msg.payload.decode()}")

sub = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
sub.on_message = on_message
sub.connect(BROKER, PORT, 60)
sub.subscribe([(TOPIC_DIGITS, 1), (TOPIC_CHARS, 1)])
sub.loop_start()

pub = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
pub.connect(BROKER, PORT, 60)
pub.loop_start()

try:
    while True:
        s = input("Введите строку (exit — выход): ")
        if s.lower() == "exit":
            break
        digits = "".join(c for c in s if c.isdigit())
        chars  = "".join(c for c in s if not c.isdigit())
        if digits:
            pub.publish(TOPIC_DIGITS, digits, qos=1)
        if chars:
            pub.publish(TOPIC_CHARS, chars, qos=1)
      
        time.sleep(0.5) 
finally:
    pub.loop_stop(); sub.loop_stop()
    pub.disconnect(); sub.disconnect()
